PORT=5000
NODE_ENV=development

# To connect to MongoDB Atlas in the future:
# 1. Create a cluster on https://cloud.mongodb.com
# 2. Under Database Access, create a database user and password
# 3. Under Network Access, whitelist your IP (or 0.0.0.0/0 for all)
# 4. Uncomment the line below and paste your Atlas connection URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/disd_heavy_machinery?retryWrites=true&w=majority
